# Copie este arquivo para ".env" (nunca versionado) para uso local com docker-compose.
# Nenhum destes valores é válido para homologação/produção — apenas desenvolvimento local.

POSTGRES_USER=ihostpro
POSTGRES_PASSWORD=ihostpro_dev
POSTGRES_DB=ihostpro

# Roles de aplicação do contexto Identity & Access (Incremento 1 plan, adendo
# final, Seção 6-7). ihostpro_app é usada por IHostPro.Api/IHostPro.Worker
# (sujeita a Row-Level Security); ihostpro_migrator é usada exclusivamente
# por IHostPro.MigrationRunner e nunca deve chegar à Api/Worker.
IHOSTPRO_APP_DB_PASSWORD=ihostpro_app_dev
IHOSTPRO_MIGRATOR_DB_PASSWORD=ihostpro_migrator_dev

RABBITMQ_DEFAULT_USER=ihostpro
RABBITMQ_DEFAULT_PASS=ihostpro_dev

MINIO_ROOT_USER=ihostpro
MINIO_ROOT_PASSWORD=ihostpro_dev

GRAFANA_ADMIN_USER=ihostpro
GRAFANA_ADMIN_PASSWORD=ihostpro_dev

# Consumido por IHostPro.Api e IHostPro.Worker (nunca hardcoded no código —
# ver ADR-007). Fora do Docker Compose, "localhost:4317" já é o padrão em
# appsettings.json. Sobrescreva via variável de ambiente quando necessário:
# OpenTelemetry__OtlpEndpoint=http://localhost:4317
