<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fase 7, Incremento 2 (Dashboard & Reporting Foundation): Checkpoint 1
    needed only IDashboardMessageExecutionScope (ADR-016 local boundary).
    Checkpoint 2 adds the first Command/Query (GetDashboardOverviewQuery),
    so Mediator.SourceGenerator is now needed here too, mirroring every
    other context's own Application project exactly.
  -->
  <ItemGroup>
    <ProjectReference Include="..\IHostPro.Contexts.Dashboard.Domain\IHostPro.Contexts.Dashboard.Domain.csproj" />
    <ProjectReference Include="..\IHostPro.Contexts.Dashboard.Contracts\IHostPro.Contexts.Dashboard.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Application\IHostPro.BuildingBlocks.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.SourceGenerator" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
