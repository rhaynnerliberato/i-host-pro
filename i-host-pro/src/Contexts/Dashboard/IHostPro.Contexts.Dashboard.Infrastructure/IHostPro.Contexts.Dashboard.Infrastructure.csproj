<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fase 7, Incremento 2 (Dashboard & Reporting Foundation), Checkpoint 1:
    local, async, event-driven projections of Reservations'/Housekeeping's/
    Property Management's own Integration Events — never a direct reference
    to any of their Domain/Application/Infrastructure, only their public
    Contracts (Architecture Principles §14: Dashboard & Reporting is a
    terminal, event-consumer-only context — mirrors Reservations.Infrastructure's
    own reference to Housekeeping.Contracts exactly, generalized to three
    source contexts here).
  -->
  <ItemGroup>
    <ProjectReference Include="..\IHostPro.Contexts.Dashboard.Domain\IHostPro.Contexts.Dashboard.Domain.csproj" />
    <ProjectReference Include="..\IHostPro.Contexts.Dashboard.Application\IHostPro.Contexts.Dashboard.Application.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Domain\IHostPro.BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Infrastructure\IHostPro.BuildingBlocks.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Application\IHostPro.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\Reservations\IHostPro.Contexts.Reservations.Contracts\IHostPro.Contexts.Reservations.Contracts.csproj" />
    <ProjectReference Include="..\..\Housekeeping\IHostPro.Contexts.Housekeeping.Contracts\IHostPro.Contexts.Housekeeping.Contracts.csproj" />
    <ProjectReference Include="..\..\PropertyManagement\IHostPro.Contexts.PropertyManagement.Contracts\IHostPro.Contexts.PropertyManagement.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Only WolverineFx.EntityFrameworkCore (IDbContextOutbox<T>) — never
         WolverineFx/WolverineFx.RabbitMQ/WolverineFx.RuntimeCompilation,
         which stay exclusive to BuildingBlocks.Infrastructure and the Host
         processes, mirroring every other context's Infrastructure project
         exactly. Dashboard publishes no event of its own this increment, but
         still needs Wolverine's envelope storage mapping
         (MapWolverineEnvelopeStorage) for its own ancillary outbox schema,
         mirroring every other context's DbContext. -->
    <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.22.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
