<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fase 5, Incremento 1 (Policy Engine Foundation). No cross-context
    Contracts reference: unlike Reservations (which needs PropertyManagement
    .Contracts for eligibility), Configuration & Policy is a foundational/
    supporting context other contexts consume (Architecture Principles §14,
    Exceção 1) — it consumes none of them itself.
  -->
  <ItemGroup>
    <ProjectReference Include="..\IHostPro.Contexts.Configuration.Domain\IHostPro.Contexts.Configuration.Domain.csproj" />
    <ProjectReference Include="..\IHostPro.Contexts.Configuration.Contracts\IHostPro.Contexts.Configuration.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Application\IHostPro.BuildingBlocks.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.SourceGenerator" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
