<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IHostPro.Contexts.Configuration.Domain\IHostPro.Contexts.Configuration.Domain.csproj" />
    <ProjectReference Include="..\IHostPro.Contexts.Configuration.Application\IHostPro.Contexts.Configuration.Application.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Domain\IHostPro.BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Infrastructure\IHostPro.BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Only WolverineFx.EntityFrameworkCore (IDbContextOutbox<T>) — never
         WolverineFx/WolverineFx.RabbitMQ/WolverineFx.RuntimeCompilation, which
         stay exclusive to BuildingBlocks.Infrastructure and the Host
         processes, mirroring every other context's Infrastructure project
         exactly. PolicyUpdated (Checkpoint 6) is the first event this
         reference is actually needed for; the mapping/schema wiring
         (MapWolverineEnvelopeStorage) is established from this checkpoint on,
         same precedent as Reservations' own Checkpoint 1. -->
    <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.22.0" />
    <!-- Checkpoint 6 (Cache e eventos): reuses the same Redis technology
         already used by Identity's SessionRevocationCache (Fase 5 §6: "usar
         Redis já existente... não criar uma segunda tecnologia de cache") —
         a separate IConnectionMultiplexer, own connection string/options,
         same as every other Bounded-Context-owned piece of shared physical
         infrastructure (mirrors how each context has its own DbContext
         against the same physical PostgreSQL instance). -->
    <PackageReference Include="StackExchange.Redis" Version="3.0.17" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Checkpoint 6: the first internal type here (CachedPolicyValueResolver,
    IPolicyValueResolver, PolicyValueResolution) complex enough to warrant
    isolated unit tests with hand-written fakes, rather than only exercising
    it indirectly through the public typed readers via a real integration
    test. Grants the unit test project (only) visibility into `internal`
    types — a standard .NET testing pattern; it does not weaken the real
    architectural boundary between Bounded Contexts, which is enforced by the
    ProjectReference graph and NetArchTest, never by C#'s `internal` alone.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="IHostPro.Contexts.Configuration.Tests.Unit" />
  </ItemGroup>

</Project>
