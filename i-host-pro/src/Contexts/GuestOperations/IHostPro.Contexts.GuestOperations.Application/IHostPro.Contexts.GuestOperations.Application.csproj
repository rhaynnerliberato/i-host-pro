<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fase 10, Checkpoint 2 — Check-in/Checkout Core: BuildingBlocks.Application
    added back (removed in CP1's own csproj with the opposite rationale) —
    ReservationCreatedGuestStayInitializer now implements
    IIntegrationEventHandler<ReservationCreated>, mirroring
    Communication.Application/Workflow.Application's own choreography
    consumers of the same event. Reservations.Contracts referenced solely
    for the ReservationCreated event type — never Reservations.Domain/
    Application/Infrastructure/Api (ordinary async Integration Event
    consumption, no new synchronous exception, Architecture Principles
    §14).

    Fase 10, Checkpoint 3 — Early Check-in / Late Checkout: two more
    Contracts-only references added, each backing a named synchronous
    exception (ADR-024 amendment). Reservations.Contracts now ALSO supplies
    IReservationScheduleReader (exception #7) alongside ReservationCreated.
    Housekeeping.Contracts supplies ICleaningReadinessReader (exception #8 —
    Housekeeping's first). Configuration.Contracts supplies
    IEarlyCheckInPolicyReader/ILateCheckoutPolicyReader — the universal
    Configuration exception every Bounded Context already holds (Fase 5).
    Never Housekeeping.Domain/Application/Infrastructure, never
    Configuration.Application/Infrastructure.

    Fase 10, Checkpoint 5 — PIX/Payment Deterministic Foundation:
    Payments.Contracts added — supplies PixChargeConfirmed, the trigger
    PixChargeConfirmedLateCheckoutApprover consumes (approved async
    boundary: Guest Operations never calls Payments synchronously). Never
    Payments.Domain/Application/Infrastructure.
  -->
  <ItemGroup>
    <ProjectReference Include="..\IHostPro.Contexts.GuestOperations.Domain\IHostPro.Contexts.GuestOperations.Domain.csproj" />
    <ProjectReference Include="..\IHostPro.Contexts.GuestOperations.Contracts\IHostPro.Contexts.GuestOperations.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Application\IHostPro.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\Reservations\IHostPro.Contexts.Reservations.Contracts\IHostPro.Contexts.Reservations.Contracts.csproj" />
    <ProjectReference Include="..\..\Housekeeping\IHostPro.Contexts.Housekeeping.Contracts\IHostPro.Contexts.Housekeeping.Contracts.csproj" />
    <ProjectReference Include="..\..\Configuration\IHostPro.Contexts.Configuration.Contracts\IHostPro.Contexts.Configuration.Contracts.csproj" />
    <ProjectReference Include="..\..\Payments\IHostPro.Contexts.Payments.Contracts\IHostPro.Contexts.Payments.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Structured logging in the command handlers (no-op/success/failure) —
         same abstractions-only package every other context's Application
         project uses, never the concrete logging implementation. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <!-- RecordGuestCheckedInCommand/RecordGuestCheckedOutCommand are now
         HTTP-exposed (Checkpoint 2) — dispatched through Mediator like every
         other HTTP-facing command in this codebase (ICommand/ICommandHandler,
         Mediator.SourceGenerator — see ADR-002). Source-generator discovery
         must run in this compilation. -->
    <PackageReference Include="Mediator.SourceGenerator" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
