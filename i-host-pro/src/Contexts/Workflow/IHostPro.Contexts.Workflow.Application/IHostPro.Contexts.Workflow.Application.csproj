<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fase 8, Checkpoint 1.1 — corrective homologation: the orchestration
    use case (ReservationCreated -> CreateCleaningForReservation) belongs
    here, never in Workflow.Infrastructure, which is transport-only. Zero
    Wolverine/EF Core/persistence dependency by design — this project must
    never gain one (see WorkflowOrchestrationArchitectureTests).
    Reservations.Contracts/Housekeeping.Contracts referenced solely for the
    Integration Event/command TYPES this checkpoint's single use case
    consumes/produces — never their Application/Infrastructure/Api layers.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Application\IHostPro.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\Reservations\IHostPro.Contexts.Reservations.Contracts\IHostPro.Contexts.Reservations.Contracts.csproj" />
    <ProjectReference Include="..\..\Housekeeping\IHostPro.Contexts.Housekeeping.Contracts\IHostPro.Contexts.Housekeeping.Contracts.csproj" />
    <!-- Fase 10, Checkpoint 1 — Guest Operations Foundation: the second
         trigger->action use case this context implements
         (GuestCheckedOut -> CloseReservation), referenced solely for the
         GuestCheckedOut event type this checkpoint consumes — never Guest
         Operations' Application/Infrastructure/Api layers. -->
    <ProjectReference Include="..\..\GuestOperations\IHostPro.Contexts.GuestOperations.Contracts\IHostPro.Contexts.GuestOperations.Contracts.csproj" />
  </ItemGroup>

  <!-- Fase 8, Checkpoint 2.1 — corrective audit gate: structured, PII-safe
       logging for the orchestration act itself (Documento 17 §28,
       proportional to a stateless single-action workflow). Abstractions-only
       package — same one Identity.Application already uses for its own
       Application-layer logging (LoginTenantBootstrapResolver/
       RefreshTokenTenantBootstrapResolver) — never the concrete logging
       implementation, never a new logging/audit framework. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
