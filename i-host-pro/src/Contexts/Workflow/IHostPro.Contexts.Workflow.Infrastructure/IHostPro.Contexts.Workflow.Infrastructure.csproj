<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Application\IHostPro.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\Reservations\IHostPro.Contexts.Reservations.Contracts\IHostPro.Contexts.Reservations.Contracts.csproj" />
    <ProjectReference Include="..\..\Housekeeping\IHostPro.Contexts.Housekeeping.Contracts\IHostPro.Contexts.Housekeeping.Contracts.csproj" />
    <!-- Fase 8, Checkpoint 1.1: the orchestration use case now lives in
         Workflow.Application; this project is transport-only (the Wolverine
         adapter + the IWorkflowCommandDispatcher implementation). -->
    <ProjectReference Include="..\IHostPro.Contexts.Workflow.Application\IHostPro.Contexts.Workflow.Application.csproj" />
    <!-- Fase 10, Checkpoint 1 — Guest Operations Foundation: GuestCheckedOutHandler
         (the thin Wolverine adapter) needs the GuestCheckedOut type. -->
    <ProjectReference Include="..\..\GuestOperations\IHostPro.Contexts.GuestOperations.Contracts\IHostPro.Contexts.GuestOperations.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fase 8, Checkpoint 1 — ADR-018: this context is stateless (no
         WorkflowDbContext, no aggregates, no persistence — approved
         Decision Material 4). Plain WolverineFx (IMessageBus,
         [NonTransactional], MessageContext) only — never
         WolverineFx.EntityFrameworkCore, which every other context's
         Infrastructure project references solely because it owns a
         DbContext this one does not have. -->
    <PackageReference Include="WolverineFx" Version="6.22.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <!-- Fase 8, Checkpoint 2.1: narrow, transport-level failure logging in
         WolverineWorkflowCommandDispatcher — never a duplicate of the
         business-level audit Workflow.Application already emits. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
