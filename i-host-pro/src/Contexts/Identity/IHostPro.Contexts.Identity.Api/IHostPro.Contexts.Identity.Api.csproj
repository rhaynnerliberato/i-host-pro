<Project Sdk="Microsoft.NET.Sdk">

  <!--
    HTTP endpoints for the Identity & Access context (Incremento 2 plan,
    Etapa 14). References ONLY Identity.Application (Commands/AuthTokensResult)
    and BuildingBlocks.Domain (Result/Error) — never Identity.Infrastructure
    ("API não pode depender de tipos concretos de Infrastructure"). The
    previous placeholder version of this project referenced
    Identity.Infrastructure directly; that reference is removed here — every
    concrete handler/executor/pipeline behavior is wired up by
    Identity.Infrastructure's AddIdentityCommandDispatch/
    AddIdentityJwtBearerAuthentication, called only from IHostPro.Api's
    composition root, never from this project.
  -->
  <ItemGroup>
    <ProjectReference Include="..\IHostPro.Contexts.Identity.Application\IHostPro.Contexts.Identity.Application.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Domain\IHostPro.BuildingBlocks.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- ControllerBase/[ApiController]/IActionResult/[Authorize] etc.
         without pulling in the full Web SDK — this stays a plain class
         library, matching every other per-context project; the standard way
         a class library references ASP.NET Core's framework assemblies. -->
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
