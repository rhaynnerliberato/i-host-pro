<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fase 3, Incremento 1: first Commands/Queries — BuildingBlocks.Application
    (ICommand/IQuery/PagedResult/ValidationBehavior), Mediator.SourceGenerator
    (source-generator discovery must run in this compilation) and
    BuildingBlocks.Messaging.Abstractions (IntegrationEvent, referenced
    transitively via Contracts already, kept explicit here since
    IIntegrationEventCollector.Enqueue takes an IntegrationEvent) are needed.

    PropertyManagement.Contracts referenced solely for
    IPropertyReservationEligibilityReader/PropertyReservationEligibility
    (Incremento 1 plan, item 4: "Reservations pode referenciar apenas:
    PropertyManagement.Contracts"). Never PropertyManagement.Application/
    Infrastructure/Api.
  -->
  <ItemGroup>
    <ProjectReference Include="..\IHostPro.Contexts.Reservations.Domain\IHostPro.Contexts.Reservations.Domain.csproj" />
    <ProjectReference Include="..\IHostPro.Contexts.Reservations.Contracts\IHostPro.Contexts.Reservations.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Application\IHostPro.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\PropertyManagement\IHostPro.Contexts.PropertyManagement.Contracts\IHostPro.Contexts.PropertyManagement.Contracts.csproj" />
    <!--
      Fase 9, Checkpoint 3.2 ("Airbnb Deterministic Foundation") — referenced
      solely for AirbnbReservationImported/Updated/Cancelled (CP3.2 mandate
      §37: "Cross-context dependency somente Contracts/event"). Ordinary
      async Integration Event consumption, the same shape as Reservations.
      Infrastructure's own existing reference to Housekeeping.Contracts for
      CleaningCreated/etc. — never Application/Infrastructure/Api.
    -->
    <ProjectReference Include="..\..\ExternalIntegrations\IHostPro.Contexts.ExternalIntegrations.Contracts\IHostPro.Contexts.ExternalIntegrations.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mediator.SourceGenerator" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Fase 9, Checkpoint 3.2 — structured logging for the Airbnb import/
      update/cancel processors. Same abstractions-only package
      Communication.Application already uses for ReservationCreatedCommunicationProcessor
      — never the concrete logging implementation.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
