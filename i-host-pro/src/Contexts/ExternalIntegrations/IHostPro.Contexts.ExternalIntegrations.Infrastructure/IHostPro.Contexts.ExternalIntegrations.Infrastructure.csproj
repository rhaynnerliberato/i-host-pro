<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IHostPro.Contexts.ExternalIntegrations.Domain\IHostPro.Contexts.ExternalIntegrations.Domain.csproj" />
    <ProjectReference Include="..\IHostPro.Contexts.ExternalIntegrations.Application\IHostPro.Contexts.ExternalIntegrations.Application.csproj" />
    <ProjectReference Include="..\IHostPro.Contexts.ExternalIntegrations.Contracts\IHostPro.Contexts.ExternalIntegrations.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Domain\IHostPro.BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Infrastructure\IHostPro.BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Fase 9, Checkpoint 2.3.3 (ADR-022 item 13) — WolverineFx.EntityFrameworkCore
    added: External Integrations now provisions a durable outbox
    (external_integrations_messaging schema) for WhatsAppMessageStatusChanged,
    its first Integration Event. Mirrors every other Bounded Context's own
    Infrastructure.csproj exactly (e.g. Reservations, version pinned identically).
  -->
  <ItemGroup>
    <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.22.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Fase 9, Checkpoint 2.2 — IHttpClientFactory for the real Meta Cloud
         API outbound connector (mandate §11: never `new HttpClient()` per
         call). -->
    <!-- 10.0.11, not 10.0.10 — Microsoft.Extensions.Http.Resilience's own
         transitive dependency requires >= 10.0.11; NU1605 otherwise. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <!-- Fase 12, Checkpoint 3 — Decision Gate amendment to the Fase 9 "no
         Polly" decision, scoped STRICTLY to HTTP circuit breaking (see
         ADR-031). Only AddCircuitBreaker is ever called against this
         package — automatic retry remains false (Meta had none before this
         checkpoint and still has none — a timeout/circuit-open still always
         maps to DeliveryOutcomeUnknown, never a resend). -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <!-- Fase 12, Checkpoint 5.3A — AWS Secrets Manager-backed
         IWhatsAppCredentialProvider/IWhatsAppWebhookCredentialProvider for
         Homolog/Production. Only the specific package, never the AWSSDK
         meta-package. -->
    <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.100.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
