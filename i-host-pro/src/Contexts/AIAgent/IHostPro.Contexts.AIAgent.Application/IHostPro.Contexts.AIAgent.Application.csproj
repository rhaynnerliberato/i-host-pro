<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fase 11, Checkpoint 2 — AI Agent Foundation. Communication.Contracts
    referenced solely for ConversationMessageReceived (the trigger this
    context consumes) — never Communication.Domain/Application/Infrastructure.
    Fase 11, Checkpoint 7 — Configuration.Contracts referenced solely for
    IAiAgentBehaviorPolicyReader/AiAgentBehaviorPolicy (Architecture
    Principles Exceção 1, synchronous Configuration & Policy consultation) —
    never Configuration.Domain/Application/Infrastructure.
  -->
  <ItemGroup>
    <ProjectReference Include="..\IHostPro.Contexts.AIAgent.Domain\IHostPro.Contexts.AIAgent.Domain.csproj" />
    <ProjectReference Include="..\IHostPro.Contexts.AIAgent.Contracts\IHostPro.Contexts.AIAgent.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Application\IHostPro.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\Communication\IHostPro.Contexts.Communication.Contracts\IHostPro.Contexts.Communication.Contracts.csproj" />
    <ProjectReference Include="..\..\Configuration\IHostPro.Contexts.Configuration.Contracts\IHostPro.Contexts.Configuration.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fase 11, Checkpoint 6 — ResumeAgentSessionCommand is AIAgent's first
         Application Command; needed Mediator for the first time, mirrors
         Communication.Application's own Checkpoint 4 package reference. -->
    <PackageReference Include="Mediator.SourceGenerator" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
