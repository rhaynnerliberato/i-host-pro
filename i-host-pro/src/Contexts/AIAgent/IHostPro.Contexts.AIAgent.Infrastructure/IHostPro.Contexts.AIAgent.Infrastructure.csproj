<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IHostPro.Contexts.AIAgent.Domain\IHostPro.Contexts.AIAgent.Domain.csproj" />
    <ProjectReference Include="..\IHostPro.Contexts.AIAgent.Application\IHostPro.Contexts.AIAgent.Application.csproj" />
    <ProjectReference Include="..\IHostPro.Contexts.AIAgent.Contracts\IHostPro.Contexts.AIAgent.Contracts.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Domain\IHostPro.BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Infrastructure\IHostPro.BuildingBlocks.Infrastructure.csproj" />
    <!-- ConversationMessageReceivedHandler (the thin Wolverine adapter) needs the ConversationMessageReceived type. -->
    <ProjectReference Include="..\..\Communication\IHostPro.Contexts.Communication.Contracts\IHostPro.Contexts.Communication.Contracts.csproj" />
    <!--
      Fase 11, Checkpoint 3 — Read Tools & Context Builder. Exception #3 (AI
      Agent Tools -> Application Services): each Read Tool calls its owning
      Bounded Context's own EXISTING Application Query through that
      context's I<Context>RequestDispatcher — never a new Contracts-tier
      reader/exception. Referencing these five .Application projects
      directly (never their .Domain/.Infrastructure/.Api) is the concrete,
      approved mechanism of Exception #3.
    -->
    <ProjectReference Include="..\..\Reservations\IHostPro.Contexts.Reservations.Application\IHostPro.Contexts.Reservations.Application.csproj" />
    <ProjectReference Include="..\..\PropertyManagement\IHostPro.Contexts.PropertyManagement.Application\IHostPro.Contexts.PropertyManagement.Application.csproj" />
    <ProjectReference Include="..\..\Housekeeping\IHostPro.Contexts.Housekeeping.Application\IHostPro.Contexts.Housekeeping.Application.csproj" />
    <ProjectReference Include="..\..\Configuration\IHostPro.Contexts.Configuration.Application\IHostPro.Contexts.Configuration.Application.csproj" />
    <ProjectReference Include="..\..\Payments\IHostPro.Contexts.Payments.Application\IHostPro.Contexts.Payments.Application.csproj" />
    <!--
      Fase 11, Checkpoint 4 — Write Tools & Response Delivery. Same Exception
      #3 mechanism: RequestEarlyCheckInTool/RequestLateCheckoutTool/
      RequestGuestAccessDeliveryTool call Guest Operations' own EXISTING
      Application Commands; AgentResponseDeliveryService calls Communication's
      own new SendAgentResponseCommand. Both referenced as .Application
      projects directly, never .Domain/.Infrastructure/.Api.
    -->
    <ProjectReference Include="..\..\GuestOperations\IHostPro.Contexts.GuestOperations.Application\IHostPro.Contexts.GuestOperations.Application.csproj" />
    <ProjectReference Include="..\..\Communication\IHostPro.Contexts.Communication.Application\IHostPro.Contexts.Communication.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.22.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Fase 11, Checkpoint 7 — real Anthropic Messages API client, mirroring
         ExternalIntegrations.Infrastructure's own precedent exactly:
         named/typed IHttpClientFactory client, never `new HttpClient()` per
         call. -->
    <!-- 10.0.11, not 10.0.10 — Microsoft.Extensions.Http.Resilience's own
         transitive dependency (Microsoft.Extensions.Http.Diagnostics)
         requires >= 10.0.11; NU1605 otherwise. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <!-- Fase 12, Checkpoint 3 — Decision Gate amendment to the Fase 9/11 "no
         Polly" decision, scoped STRICTLY to HTTP circuit breaking (see
         ADR-031). Only AddCircuitBreaker is ever called against this
         package — no AddRetry/AddHedging/AddTimeout/AddFallback: the
         single, already-homologated application-level Anthropic retry
         (ConversationMessageReceivedProcessor.GenerateWithRetryAsync) is
         untouched and remains the only retry in this path. -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
