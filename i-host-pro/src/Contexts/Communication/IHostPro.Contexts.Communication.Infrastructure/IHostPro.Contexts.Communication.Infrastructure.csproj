    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Infrastructure\IHostPro.BuildingBlocks.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Application\IHostPro.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\IHostPro.Contexts.Communication.Domain\IHostPro.Contexts.Communication.Domain.csproj" />
    <ProjectReference Include="..\IHostPro.Contexts.Communication.Application\IHostPro.Contexts.Communication.Application.csproj" />
    <ProjectReference Include="..\..\Reservations\IHostPro.Contexts.Reservations.Contracts\IHostPro.Contexts.Reservations.Contracts.csproj" />
    <!-- Fase 9, Checkpoint 2.2 — ADR-021's sixth synchronous exception:
         Communication may reference ExternalIntegrations.Contracts ONLY
         (never Domain/Application/Infrastructure/Api). Consumed by
         ExternalIntegrationsWhatsAppConnector, the real IOutboundMessageConnector
         implementation that adapts to IMessagingProvider. -->
    <ProjectReference Include="..\..\ExternalIntegrations\IHostPro.Contexts.ExternalIntegrations.Contracts\IHostPro.Contexts.ExternalIntegrations.Contracts.csproj" />
    <!-- Fase 10, Checkpoint 4 (Portaria Notification Foundation): the
         Wolverine adapters for GuestCheckedIn/EarlyCheckinApproved/
         LateCheckoutApproved reference these event types directly. -->
    <ProjectReference Include="..\..\GuestOperations\IHostPro.Contexts.GuestOperations.Contracts\IHostPro.Contexts.GuestOperations.Contracts.csproj" />
    <!-- Fase 10, Checkpoint 5 — PixChargeCreatedHandler (the thin Wolverine
         adapter) needs the PixChargeCreated type. -->
    <ProjectReference Include="..\..\Payments\IHostPro.Contexts.Payments.Contracts\IHostPro.Contexts.Payments.Contracts.csproj" />
    <!-- Fase 11, Checkpoint 2 (AI Agent Foundation) — Communication's first
         published Integration Event (ConversationMessageReceived). -->
    <ProjectReference Include="..\IHostPro.Contexts.Communication.Contracts\IHostPro.Contexts.Communication.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Fase 11, Checkpoint 2 (AI Agent Foundation): Communication now
         publishes its own first Integration Event (ConversationMessageReceived)
         and needs the real Wolverine outbox — upgraded from plain WolverineFx
         (the thin transport adapter) to WolverineFx.EntityFrameworkCore
         (IDbContextOutbox<T>, MapWolverineEnvelopeStorage), mirroring every
         other publishing Bounded Context's own Infrastructure project
         (e.g. Payments). -->
    <PackageReference Include="WolverineFx.EntityFrameworkCore" Version="6.22.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

