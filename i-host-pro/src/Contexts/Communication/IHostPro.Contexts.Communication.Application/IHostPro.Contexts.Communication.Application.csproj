    reacts directly (choreography, Fase 8's own criterion) to ReservationCreated
    — no Workflow Orchestration involved. Reservations.Contracts/
    Configuration.Contracts referenced solely for the Integration Event type
    Communication consumes and the two approved synchronous-query contracts
    (IReservationGuestContactReader — ADR-019; ITemplateReader — the general
    Configuration & Policy exception, ADR-002) — never those contexts'
    Application/Infrastructure/Api layers.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Domain\IHostPro.BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Application\IHostPro.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\IHostPro.Contexts.Communication.Domain\IHostPro.Contexts.Communication.Domain.csproj" />
    <ProjectReference Include="..\..\Reservations\IHostPro.Contexts.Reservations.Contracts\IHostPro.Contexts.Reservations.Contracts.csproj" />
    <ProjectReference Include="..\..\Configuration\IHostPro.Contexts.Configuration.Contracts\IHostPro.Contexts.Configuration.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Structured, PII-safe audit logging — same package/pattern already
         used by Identity.Application/Workflow.Application. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
