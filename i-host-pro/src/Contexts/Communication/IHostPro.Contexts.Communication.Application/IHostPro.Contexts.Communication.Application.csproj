<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fase 9, Checkpoint 1 — "Comunicação e Integrações do MVP": Communication
    reacts directly (choreography, Fase 8's own criterion) to ReservationCreated
    — no Workflow Orchestration involved. Reservations.Contracts/
    Configuration.Contracts referenced solely for the Integration Event type
    Communication consumes and the two approved synchronous-query contracts
    (IReservationGuestContactReader — ADR-019; ITemplateReader — the general
    Configuration & Policy exception, ADR-002) — never those contexts'
    Application/Infrastructure/Api layers.

    Fase 9, Checkpoint 2.3.3 (ADR-022 item 14): ExternalIntegrations.Contracts
    added — WhatsAppMessageStatusChanged is the second Integration Event
    Communication consumes, same "Contracts only, never Domain/Application/
    Infrastructure/Api" boundary already enforced by
    IHostPro.ArchitectureTests' own ExternalIntegrationsDependencyTests.

    Fase 10, Checkpoint 4 (Portaria Notification Foundation): GuestOperations.Contracts
    added — GuestCheckedIn/EarlyCheckinApproved/LateCheckoutApproved are the
    third/fourth/fifth Integration Events Communication consumes.
    PropertyManagement.Contracts added — IFrontDeskContactReader is the new
    synchronous exception #9 (ADR-026), same "Contracts only" boundary.

    Fase 10, Checkpoint 5 (PIX/Payment Deterministic Foundation):
    Payments.Contracts added — PixChargeCreated is the sixth Integration
    Event Communication consumes; IPixChargeDeliveryReader is the new
    synchronous exception #11 (ADR-027), same "Contracts only" boundary.

    Fase 11, Checkpoint 2 (AI Agent Foundation): Communication.Contracts
    added — Communication's OWN first published Integration Event
    (ConversationMessageReceived), consumed downstream by the new AI Agent
    Bounded Context.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Domain\IHostPro.BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\IHostPro.BuildingBlocks.Application\IHostPro.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\IHostPro.Contexts.Communication.Domain\IHostPro.Contexts.Communication.Domain.csproj" />
    <ProjectReference Include="..\IHostPro.Contexts.Communication.Contracts\IHostPro.Contexts.Communication.Contracts.csproj" />
    <ProjectReference Include="..\..\Reservations\IHostPro.Contexts.Reservations.Contracts\IHostPro.Contexts.Reservations.Contracts.csproj" />
    <ProjectReference Include="..\..\Configuration\IHostPro.Contexts.Configuration.Contracts\IHostPro.Contexts.Configuration.Contracts.csproj" />
    <ProjectReference Include="..\..\ExternalIntegrations\IHostPro.Contexts.ExternalIntegrations.Contracts\IHostPro.Contexts.ExternalIntegrations.Contracts.csproj" />
    <ProjectReference Include="..\..\GuestOperations\IHostPro.Contexts.GuestOperations.Contracts\IHostPro.Contexts.GuestOperations.Contracts.csproj" />
    <ProjectReference Include="..\..\PropertyManagement\IHostPro.Contexts.PropertyManagement.Contracts\IHostPro.Contexts.PropertyManagement.Contracts.csproj" />
    <ProjectReference Include="..\..\Payments\IHostPro.Contexts.Payments.Contracts\IHostPro.Contexts.Payments.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Fase 11, Checkpoint 4 — SendAgentResponseCommand is Communication's
         first Application Command; needed Mediator for the first time,
         mirrors Payments.Application's own Checkpoint 3 package reference. -->
    <PackageReference Include="Mediator.SourceGenerator" Version="3.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Structured, PII-safe audit logging — same package/pattern already
         used by Identity.Application/Workflow.Application. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
