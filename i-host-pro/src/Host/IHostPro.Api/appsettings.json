{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "Properties": {
      "Application": "IHostPro.Api"
    }
  },
  "ConnectionStrings": {
    "Identity": "Host=localhost;Port=5432;Database=ihostpro;Username=ihostpro_app;Password=ihostpro_app_dev",
    "PropertyManagement": "Host=localhost;Port=5432;Database=ihostpro;Username=ihostpro_app;Password=ihostpro_app_dev",
    "Reservations": "Host=localhost;Port=5432;Database=ihostpro;Username=ihostpro_app;Password=ihostpro_app_dev",
    "Configuration": "Host=localhost;Port=5432;Database=ihostpro;Username=ihostpro_app;Password=ihostpro_app_dev",
    "Housekeeping": "Host=localhost;Port=5432;Database=ihostpro;Username=ihostpro_app;Password=ihostpro_app_dev",
    "Dashboard": "Host=localhost;Port=5432;Database=ihostpro;Username=ihostpro_app;Password=ihostpro_app_dev",
    "Communication": "Host=localhost;Port=5432;Database=ihostpro;Username=ihostpro_app;Password=ihostpro_app_dev",
    "ExternalIntegrations": "Host=localhost;Port=5432;Database=ihostpro;Username=ihostpro_app;Password=ihostpro_app_dev",
    "GuestOperations": "Host=localhost;Port=5432;Database=ihostpro;Username=ihostpro_app;Password=ihostpro_app_dev",
    "AIAgent": "Host=localhost;Port=5432;Database=ihostpro;Username=ihostpro_app;Password=ihostpro_app_dev",
    "Platform": "Host=localhost;Port=5432;Database=ihostpro;Username=ihostpro_app;Password=ihostpro_app_dev"
  },
  "Identity": {
    "Jwt": {
      "Issuer": "https://identity.ihostpro.local",
      "Audience": "ihostpro-api"
    },
    "SessionRevocationCache": {
      "ConnectionString": "localhost:6379"
    }
  },
  "Configuration": {
    "PolicyCache": {
      "ConnectionString": "localhost:6379"
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "Redis": {
      "ConnectionString": "localhost:6379"
    },
    "Policies": {
      "Authentication": { "PermitLimit": 30, "Window": "00:01:00", "FailureMode": "FailClosed" },
      "Webhook": { "PermitLimit": 600, "Window": "00:01:00", "FailureMode": "FailOpen" },
      "TenantApi": { "PermitLimit": 1000, "Window": "00:01:00", "FailureMode": "FailOpen" },
      "AdminApi": { "PermitLimit": 500, "Window": "00:01:00", "FailureMode": "FailOpen" },
      "AiExpensiveOperation": { "PermitLimit": 60, "Window": "00:01:00", "FailureMode": "FailOpen" }
    }
  },
  "ExternalIntegrations": {
    "WhatsApp": {
      "Meta": {
        "GraphApiVersion": "v26.0",
        "TimeoutSeconds": 15
      }
    }
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "UseTls": false
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  },
  "AllowedHosts": "*"
}
