<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required for local secrets (JWT dev signing key, DevelopmentSeed
         admin password) to be sourced from User Secrets instead of a
         committed appsettings file — Incremento 2 plan, ajuste 4. -->
    <UserSecretsId>dotnet-IHostPro.Api-ffaa4964-a352-4170-8e93-b0b5f8dcf47b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Explicit pin — see IHostPro.Contexts.Identity.Api.csproj for the MSB3277 rationale. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\IHostPro.BuildingBlocks.Application\IHostPro.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\IHostPro.BuildingBlocks.Infrastructure\IHostPro.BuildingBlocks.Infrastructure.csproj" />
    <!-- One line per module (Architecture Principles, Section 16). -->
    <ProjectReference Include="..\..\Contexts\Identity\IHostPro.Contexts.Identity.Infrastructure\IHostPro.Contexts.Identity.Infrastructure.csproj" />
    <!-- HTTP endpoints (Incremento 2 plan, Etapa 14) — referenced so
         AddControllers() discovers AuthController; Identity.Api itself
         never references Identity.Infrastructure. -->
    <ProjectReference Include="..\..\Contexts\Identity\IHostPro.Contexts.Identity.Api\IHostPro.Contexts.Identity.Api.csproj" />
    <!-- Property Management module (Fase 2, Incremento 1, Checkpoint 1). -->
    <ProjectReference Include="..\..\Contexts\PropertyManagement\IHostPro.Contexts.PropertyManagement.Infrastructure\IHostPro.Contexts.PropertyManagement.Infrastructure.csproj" />
    <!-- HTTP endpoints (Checkpoint 2) — referenced so AddControllers()
         discovers CondominiumsController; PropertyManagement.Api itself
         never references PropertyManagement.Infrastructure. -->
    <ProjectReference Include="..\..\Contexts\PropertyManagement\IHostPro.Contexts.PropertyManagement.Api\IHostPro.Contexts.PropertyManagement.Api.csproj" />
    <ProjectReference Include="..\..\Contexts\Reservations\IHostPro.Contexts.Reservations.Api\IHostPro.Contexts.Reservations.Api.csproj" />
    <ProjectReference Include="..\..\Contexts\Reservations\IHostPro.Contexts.Reservations.Infrastructure\IHostPro.Contexts.Reservations.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Contexts\Reservations\IHostPro.Contexts.Reservations.Contracts\IHostPro.Contexts.Reservations.Contracts.csproj" />
    <!-- Configuration & Policy module (Fase 5, Incremento 1 — Policy Engine
         Foundation, Checkpoint 1). No HTTP endpoint exists yet
         (PoliciesController is Checkpoint 4) — Api is still referenced now,
         matching every other context's own Program.cs reference shape, so
         AddControllers() picks it up automatically the moment it exists. -->
    <ProjectReference Include="..\..\Contexts\Configuration\IHostPro.Contexts.Configuration.Api\IHostPro.Contexts.Configuration.Api.csproj" />
    <ProjectReference Include="..\..\Contexts\Configuration\IHostPro.Contexts.Configuration.Infrastructure\IHostPro.Contexts.Configuration.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Contexts\Configuration\IHostPro.Contexts.Configuration.Application\IHostPro.Contexts.Configuration.Application.csproj" />
    <!-- Housekeeping module (Fase 6, Incremento 1 — Housekeeping Foundation). -->
    <ProjectReference Include="..\..\Contexts\Housekeeping\IHostPro.Contexts.Housekeeping.Api\IHostPro.Contexts.Housekeeping.Api.csproj" />
    <ProjectReference Include="..\..\Contexts\Housekeeping\IHostPro.Contexts.Housekeeping.Infrastructure\IHostPro.Contexts.Housekeeping.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Contexts\Housekeeping\IHostPro.Contexts.Housekeeping.Contracts\IHostPro.Contexts.Housekeeping.Contracts.csproj" />
    <!-- Dashboard & Reporting module (Fase 7, Incremento 2, Checkpoint 2 —
         Overview API is this module's first HTTP endpoint). -->
    <ProjectReference Include="..\..\Contexts\Dashboard\IHostPro.Contexts.Dashboard.Api\IHostPro.Contexts.Dashboard.Api.csproj" />
    <ProjectReference Include="..\..\Contexts\Dashboard\IHostPro.Contexts.Dashboard.Infrastructure\IHostPro.Contexts.Dashboard.Infrastructure.csproj" />
    <!-- External Integrations module (Fase 9, Checkpoint 2.1 — foundation
         only: administrative WhatsApp integration configuration API). -->
    <ProjectReference Include="..\..\Contexts\ExternalIntegrations\IHostPro.Contexts.ExternalIntegrations.Api\IHostPro.Contexts.ExternalIntegrations.Api.csproj" />
    <ProjectReference Include="..\..\Contexts\ExternalIntegrations\IHostPro.Contexts.ExternalIntegrations.Infrastructure\IHostPro.Contexts.ExternalIntegrations.Infrastructure.csproj" />
    <!-- Guest Operations module (Fase 10, Checkpoint 1 — Guest Operations
         Foundation). No .Api project this checkpoint (zero public API
         endpoints — mirrors Workflow.Infrastructure's own precedent of
         skipping an unused Api project until a real endpoint exists). -->
    <ProjectReference Include="..\..\Contexts\GuestOperations\IHostPro.Contexts.GuestOperations.Infrastructure\IHostPro.Contexts.GuestOperations.Infrastructure.csproj" />
  </ItemGroup>

</Project>
