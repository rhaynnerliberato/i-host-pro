<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required for local secrets (JWT dev signing key, DevelopmentSeed
         admin password) to be sourced from User Secrets instead of a
         committed appsettings file — Incremento 2 plan, ajuste 4. -->
    <UserSecretsId>dotnet-IHostPro.Api-ffaa4964-a352-4170-8e93-b0b5f8dcf47b</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Explicit pin — see IHostPro.Contexts.Identity.Api.csproj for the MSB3277 rationale. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\IHostPro.BuildingBlocks.Application\IHostPro.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\IHostPro.BuildingBlocks.Infrastructure\IHostPro.BuildingBlocks.Infrastructure.csproj" />
    <!-- One line per module (Architecture Principles, Section 16). -->
    <ProjectReference Include="..\..\Contexts\Identity\IHostPro.Contexts.Identity.Infrastructure\IHostPro.Contexts.Identity.Infrastructure.csproj" />
    <!-- HTTP endpoints (Incremento 2 plan, Etapa 14) — referenced so
         AddControllers() discovers AuthController; Identity.Api itself
         never references Identity.Infrastructure. -->
    <ProjectReference Include="..\..\Contexts\Identity\IHostPro.Contexts.Identity.Api\IHostPro.Contexts.Identity.Api.csproj" />
    <!-- Property Management module (Fase 2, Incremento 1, Checkpoint 1). -->
    <ProjectReference Include="..\..\Contexts\PropertyManagement\IHostPro.Contexts.PropertyManagement.Infrastructure\IHostPro.Contexts.PropertyManagement.Infrastructure.csproj" />
    <!-- HTTP endpoints (Checkpoint 2) — referenced so AddControllers()
         discovers CondominiumsController; PropertyManagement.Api itself
         never references PropertyManagement.Infrastructure. -->
    <ProjectReference Include="..\..\Contexts\PropertyManagement\IHostPro.Contexts.PropertyManagement.Api\IHostPro.Contexts.PropertyManagement.Api.csproj" />
    <ProjectReference Include="..\..\Contexts\Reservations\IHostPro.Contexts.Reservations.Api\IHostPro.Contexts.Reservations.Api.csproj" />
    <ProjectReference Include="..\..\Contexts\Reservations\IHostPro.Contexts.Reservations.Infrastructure\IHostPro.Contexts.Reservations.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Contexts\Reservations\IHostPro.Contexts.Reservations.Contracts\IHostPro.Contexts.Reservations.Contracts.csproj" />
  </ItemGroup>

</Project>
