{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "Properties": {
      "Application": "IHostPro.Worker"
    }
  },
  "ConnectionStrings": {
    "Identity": "Host=localhost;Port=5432;Database=ihostpro;Username=ihostpro_app;Password=ihostpro_app_dev"
  },
  "Identity": {
    "Jwt": {
      "Issuer": "https://identity.ihostpro.local",
      "Audience": "ihostpro-api"
    }
  },
  "RabbitMq": {
    "Host": "localhost",
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "http://localhost:4317"
  }
}
