    "Reservations": "Host=localhost;Port=5432;Database=ihostpro;Username=ihostpro_app;Password=ihostpro_app_dev",
    "Dashboard": "Host=localhost;Port=5432;Database=ihostpro;Username=ihostpro_app;Password=ihostpro_app_dev",
    "Communication": "Host=localhost;Port=5432;Database=ihostpro;Username=ihostpro_app;Password=ihostpro_app_dev",
    "GuestOperations": "Host=localhost;Port=5432;Database=ihostpro;Username=ihostpro_app;Password=ihostpro_app_dev",
