<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-IHostPro.Worker-cc769433-0535-453a-bbdf-17f44d398b0c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <!-- Explicit pin — see IHostPro.Contexts.Identity.Api.csproj for the MSB3277 rationale. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\IHostPro.BuildingBlocks.Application\IHostPro.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\IHostPro.BuildingBlocks.Infrastructure\IHostPro.BuildingBlocks.Infrastructure.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\IHostPro.BuildingBlocks.Messaging.Abstractions\IHostPro.BuildingBlocks.Messaging.Abstractions.csproj" />
    <!-- One line per module (Architecture Principles, Section 16). -->
    <ProjectReference Include="..\..\Contexts\Identity\IHostPro.Contexts.Identity.Infrastructure\IHostPro.Contexts.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Contexts\Configuration\IHostPro.Contexts.Configuration.Infrastructure\IHostPro.Contexts.Configuration.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Contexts\Housekeeping\IHostPro.Contexts.Housekeeping.Infrastructure\IHostPro.Contexts.Housekeeping.Infrastructure.csproj" />
    <!-- Fase 10, Checkpoint 4 (Portaria Notification Foundation, ADR-026):
         Worker's first-ever Property Management wiring — Communication's
         new Front Desk processors resolve the current front desk contact
         via IFrontDeskContactReader, implemented here. Read-only from this
         process — no command dispatch, no writes. -->
    <ProjectReference Include="..\..\Contexts\PropertyManagement\IHostPro.Contexts.PropertyManagement.Infrastructure\IHostPro.Contexts.PropertyManagement.Infrastructure.csproj" />
    <!-- Fase 7, Incremento 1 (Agenda Foundation, Checkpoint 1): Worker's
         first-ever Reservations wiring — consumes Housekeeping's own
         CleaningCreated into this context's local schedule projection. -->
    <ProjectReference Include="..\..\Contexts\Reservations\IHostPro.Contexts.Reservations.Infrastructure\IHostPro.Contexts.Reservations.Infrastructure.csproj" />
    <!-- Fase 7, Incremento 2 (Dashboard & Reporting Foundation, Checkpoint
         1): Worker's first-ever Dashboard wiring — consumes Reservations'/
         Housekeeping's/Property Management's own events into this new
         context's local read-model projections. -->
    <ProjectReference Include="..\..\Contexts\Dashboard\IHostPro.Contexts.Dashboard.Infrastructure\IHostPro.Contexts.Dashboard.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Contexts\Workflow\IHostPro.Contexts.Workflow.Infrastructure\IHostPro.Contexts.Workflow.Infrastructure.csproj" />
    <!-- Fase 9, Checkpoint 1 (Comunicação e Integrações do MVP): Worker's
         first-ever Communication wiring — consumes Reservations' own
         ReservationCreated to resolve a Template (Configuration) and read
         the guest contact (Reservations, ADR-019), dispatching through a
         fake WhatsApp connector this checkpoint. -->
    <ProjectReference Include="..\..\Contexts\Communication\IHostPro.Contexts.Communication.Infrastructure\IHostPro.Contexts.Communication.Infrastructure.csproj" />
    <!-- Fase 10, Checkpoint 2 (Check-in/Checkout Core): Worker's first-ever
         Guest Operations wiring — consumes Reservations' own
         ReservationCreated to auto-create a local GuestStayOperation
         (choreography). CP1 registered nothing here (zero Wolverine
         consumers that checkpoint). -->
    <ProjectReference Include="..\..\Contexts\GuestOperations\IHostPro.Contexts.GuestOperations.Infrastructure\IHostPro.Contexts.GuestOperations.Infrastructure.csproj" />
    <!-- Fase 10, Checkpoint 5 (PIX/Payment Deterministic Foundation):
         Worker's first-ever Payments wiring — consumes Guest Operations'
         own LateCheckoutPaymentRequired to create a PixCharge via the (fake,
         this checkpoint) IPixProvider, and consumes its own
         PixChargeConfirmationReceived seam. -->
    <ProjectReference Include="..\..\Contexts\Payments\IHostPro.Contexts.Payments.Infrastructure\IHostPro.Contexts.Payments.Infrastructure.csproj" />
    <!-- Fase 10, Checkpoint 5: Worker's first-ever External Integrations
         wiring — registers FakePixProvider (IPixProvider, ADR-025) for
         Payments' own consumer above. Only AddExternalIntegrationsPixProvider
         is called from this process — never the full AddExternalIntegrationsModule
         (no ExternalIntegrationsDbContext access needed here). -->
    <ProjectReference Include="..\..\Contexts\ExternalIntegrations\IHostPro.Contexts.ExternalIntegrations.Infrastructure\IHostPro.Contexts.ExternalIntegrations.Infrastructure.csproj" />
  </ItemGroup>
</Project>
