<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="7.*" />
    <!-- GuestStayOperationsControllerAuthorizationTests builds a real
         ASP.NET Core TestServer host — mirrors
         WhatsAppIntegrationEndpointsAuthorizationTests' own precedent. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <!-- Explicit pin — see IHostPro.Contexts.Identity.Api.csproj for the MSB3277 rationale. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.1.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Contexts\GuestOperations\IHostPro.Contexts.GuestOperations.Domain\IHostPro.Contexts.GuestOperations.Domain.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\GuestOperations\IHostPro.Contexts.GuestOperations.Contracts\IHostPro.Contexts.GuestOperations.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\GuestOperations\IHostPro.Contexts.GuestOperations.Application\IHostPro.Contexts.GuestOperations.Application.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\GuestOperations\IHostPro.Contexts.GuestOperations.Infrastructure\IHostPro.Contexts.GuestOperations.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\GuestOperations\IHostPro.Contexts.GuestOperations.Api\IHostPro.Contexts.GuestOperations.Api.csproj" />
    <!--
      Test-only: seeds real Reservation aggregates directly via
      Reservations' own DbContext, and references IHostPro.MigrationRunner
      to exercise the real GuestStayOperationBackfillBootstrapStep (ADR-017,
      Fase 10, Checkpoint 2 — Existing Reservation Upgrade Strategy) against
      a Testcontainers Postgres — mirrors Dashboard's own
      DashboardProjectionBootstrapStepsTests.csproj precedent. Never a
      production reference from Guest Operations' own src/ code.
    -->
    <ProjectReference Include="..\..\..\..\src\Contexts\Reservations\IHostPro.Contexts.Reservations.Domain\IHostPro.Contexts.Reservations.Domain.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\Reservations\IHostPro.Contexts.Reservations.Infrastructure\IHostPro.Contexts.Reservations.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\PropertyManagement\IHostPro.Contexts.PropertyManagement.Domain\IHostPro.Contexts.PropertyManagement.Domain.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\PropertyManagement\IHostPro.Contexts.PropertyManagement.Infrastructure\IHostPro.Contexts.PropertyManagement.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\Identity\IHostPro.Contexts.Identity.Domain\IHostPro.Contexts.Identity.Domain.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\Identity\IHostPro.Contexts.Identity.Infrastructure\IHostPro.Contexts.Identity.Infrastructure.csproj" />
    <!--
      Test-only dependency on Identity.Api: builds a realistic host with a
      REAL JWT issued/validated by Identity's own stack — mirrors
      WhatsAppIntegrationEndpointsAuthorizationTests' own precedent exactly.
      Never a production reference from Guest Operations' own src/ code.
    -->
    <ProjectReference Include="..\..\..\..\src\Contexts\Identity\IHostPro.Contexts.Identity.Api\IHostPro.Contexts.Identity.Api.csproj" />
    <ProjectReference Include="..\..\..\..\src\BuildingBlocks\IHostPro.BuildingBlocks.Infrastructure\IHostPro.BuildingBlocks.Infrastructure.csproj" />
