<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="7.*" />
    <!-- Explicit pin — see IHostPro.Contexts.Identity.Api.csproj for the MSB3277 rationale. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.1.0" />
    <!-- DashboardReservationProjectionSynchronizerTests builds its own
         minimal Wolverine host (PersistMessagesWithPostgresql/
         EnrollAncillaryPostgresqlOutbox) to drive the synchronizer through a
         real outbox-transactional write path — mirrors
         CleaningScheduleProjectionSynchronizerTests' own precedent. -->
    <PackageReference Include="WolverineFx.Postgresql" Version="6.22.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Contexts\Dashboard\IHostPro.Contexts.Dashboard.Domain\IHostPro.Contexts.Dashboard.Domain.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\Dashboard\IHostPro.Contexts.Dashboard.Contracts\IHostPro.Contexts.Dashboard.Contracts.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\Dashboard\IHostPro.Contexts.Dashboard.Application\IHostPro.Contexts.Dashboard.Application.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\Dashboard\IHostPro.Contexts.Dashboard.Infrastructure\IHostPro.Contexts.Dashboard.Infrastructure.csproj" />
    <!--
      Test-only: seeds real aggregates (Reservation/Cleaning/CleaningOccurrence/
      Property) directly via each source context's own DbContext, and
      references IHostPro.MigrationRunner to exercise the real
      Dashboard*ProjectionBootstrapStep classes (ADR-017, Fase 7, Incremento
      2, Checkpoint 1) against a Testcontainers Postgres — mirrors
      Housekeeping's own PropertyProjectionBootstrapTests.csproj precedent.
      Never a production reference from Dashboard's own src/ code.
    -->
    <ProjectReference Include="..\..\..\..\src\Contexts\Reservations\IHostPro.Contexts.Reservations.Domain\IHostPro.Contexts.Reservations.Domain.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\Reservations\IHostPro.Contexts.Reservations.Infrastructure\IHostPro.Contexts.Reservations.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\Housekeeping\IHostPro.Contexts.Housekeeping.Domain\IHostPro.Contexts.Housekeeping.Domain.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\Housekeeping\IHostPro.Contexts.Housekeeping.Infrastructure\IHostPro.Contexts.Housekeeping.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\PropertyManagement\IHostPro.Contexts.PropertyManagement.Domain\IHostPro.Contexts.PropertyManagement.Domain.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\PropertyManagement\IHostPro.Contexts.PropertyManagement.Infrastructure\IHostPro.Contexts.PropertyManagement.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\Identity\IHostPro.Contexts.Identity.Domain\IHostPro.Contexts.Identity.Domain.csproj" />
    <ProjectReference Include="..\..\..\..\src\Contexts\Identity\IHostPro.Contexts.Identity.Infrastructure\IHostPro.Contexts.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\..\src\BuildingBlocks\IHostPro.BuildingBlocks.Infrastructure\IHostPro.BuildingBlocks.Infrastructure.csproj" />
