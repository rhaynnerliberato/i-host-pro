<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="7.*" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.0" />
    <!-- Explicit pin — see IHostPro.Contexts.Identity.Api.csproj for the MSB3277 rationale. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.1.0" />
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.1.0" />
    <!-- Fase 5 (Configuration and Policy), Checkpoint 7 preventive test
         (PolicyUpdatedWolverineDiscoveryTests) — same version already used by
         IHostPro.Contexts.Configuration.Tests.Integration/IHostPro.Contexts.Identity.Tests.Integration. -->
    <PackageReference Include="Testcontainers.Redis" Version="4.1.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Deliberately references ONLY IHostPro.Api itself (the real Host
      project) — never re-registers any service by hand. The whole point of
      this test file (Checkpoint 6 homologação — Wolverine Main/Ancillary
      store regression) is to exercise Program.cs's REAL composition root,
      not a hand-assembled subset of it, per the Fase 2 plan: "Não
      reproduzir manualmente uma lista parcial de serviços. Usar o
      composition root real do Program.cs."
    -->
    <ProjectReference Include="..\..\..\src\Host\IHostPro.Api\IHostPro.Api.csproj" />
    <!--
      Needed only for direct-EF seeding and for resolving IWolverineRuntime/
      IMessageStore types by name in assertions — never to re-register any
      service (that is already done, correctly, by IHostPro.Api itself).
    -->
    <ProjectReference Include="..\..\..\src\Contexts\Identity\IHostPro.Contexts.Identity.Infrastructure\IHostPro.Contexts.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\Contexts\PropertyManagement\IHostPro.Contexts.PropertyManagement.Infrastructure\IHostPro.Contexts.PropertyManagement.Infrastructure.csproj" />
    <ProjectReference Include="..\..\..\src\BuildingBlocks\IHostPro.BuildingBlocks.Infrastructure\IHostPro.BuildingBlocks.Infrastructure.csproj" />
    <!--
      ADR-020 spike (cross-phase Wolverine handler-chain-isolation
      investigation) — needed only by WolverineHandlerChainIsolationBaselineTests's
      own deliberately minimal, structural-diagnostic host (see that file's
      own doc comment for why it does not use IHostPro.Api's full composition
      root, unlike WolverineThreeStoreCompositionTests above). Workflow has no
      HTTP surface, so IHostPro.Api never references it — this test needs it
      directly.
    -->
    <ProjectReference Include="..\..\..\src\Contexts\Workflow\IHostPro.Contexts.Workflow.Infrastructure\IHostPro.Contexts.Workflow.Infrastructure.csproj" />
    <!--
      Fase 9, Checkpoint 1 real transport gate — needed only to read
      communication.messages directly for assertions (IHostPro.Api itself
      never references Communication, per CommunicationModuleExtensions'
      own doc comment — the real consumer under test here is the separate
      IHostPro.Worker.dll subprocess).
    -->
    <ProjectReference Include="..\..\..\src\Contexts\Communication\IHostPro.Contexts.Communication.Domain\IHostPro.Contexts.Communication.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\Contexts\Communication\IHostPro.Contexts.Communication.Infrastructure\IHostPro.Contexts.Communication.Infrastructure.csproj" />
  </ItemGroup>

</Project>
